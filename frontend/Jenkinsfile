pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        S3_BUCKET = 'mybucket-2026-00'
        CLOUDFRONT_DISTRIBUTION_ID = 'E62OT6EWXIXUL'
    }

    stages {

        stage('checkout') {
            steps {
                git credentialsId: 'github-cred', url: 'https://github.com/Sakthi5577/code-task.git'
            }
        }

        stage('install dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Build') {
            steps {
                 dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy to S3') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'kiaq-aws-cred']]) {
                    sh """
                    /usr/local/bin/aws s3 sync frontend/build/ s3://${S3_BUCKET} --delete
                    """
                }
            }
        }

        stage('Invalidate CloudFront Cache') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'kiaq-aws-cred']]) {
                    sh """
                    /usr/local/bin/aws cloudfront create-invalidation \
                    --distribution-id ${CLOUDFRONT_DISTRIBUTION_ID} \
                    --paths '/*'
                    """
                }
            }
        }
    }
}
